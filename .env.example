# Copier en .env à la racine du projet (chargé automatiquement en développement).
NODE_ENV=development
PORT=3000
# Relatif à la racine du projet, ou absolu (/data en production).
DATA_DIR=./data
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Authentification (facultative en développement, obligatoire en production) :
# SESSION_SECRET=<32 caractères minimum>
# Premier compte (administrateur, détient la bibliothèque existante) ; empreinte générée par
# `pnpm --filter @mes-recettes/api hash-password`. Les autres comptes arrivent par invitation.
# ADMIN_EMAIL=moi@example.fr
# AUTH_PASSWORD_HASH='scrypt$…$…'

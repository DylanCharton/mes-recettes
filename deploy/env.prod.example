# Modèle de /srv/mes-recettes/.env (production). Aucune vraie valeur ici : le vrai .env n'existe
# que sur le VPS (root, 600). deploy.sh demande les clés absentes et met IMAGE à jour.
IMAGE=mes-recettes:<tag>
# Premier compte (n° 1, administrateur) ; ignorés une fois ce compte doté d'un mot de passe.
ADMIN_EMAIL=moi@example.fr
# Généré sur ton poste : pnpm --filter @mes-recettes/api hash-password
AUTH_PASSWORD_HASH='scrypt$…$…'
# Généré automatiquement par deploy.sh s'il manque ; le changer déconnecte tous les appareils.
SESSION_SECRET=<48 octets aléatoires>
# LOG_LEVEL=info
